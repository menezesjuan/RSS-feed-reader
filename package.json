{
  "name": "frontpage-feed-reader",
  "version": "1.0.0",
  "description": "Frontpage — RSS & Atom Feed Reader (Frontend Mentor Challenge)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:css": "npx @tailwindcss/cli -i ./client/css/input.css -o ./client/css/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./client/css/input.css -o ./client/css/output.css --watch",
    "build": "npm run build:css"
  },
  "keywords": [
    "rss",
    "atom",
    "feed-reader",
    "frontend-mentor"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.1",
    "tailwindcss": "^4.1.1"
  }
}
